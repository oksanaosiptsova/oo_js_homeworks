      "name": "Book ISBN Numbers HM Osiptsova",
      "item": [
        {
          "name": "Is Valid ISBN13 Number valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response contains m:IsValidISBN13Result\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"m:IsValidISBN13Result\");",
                  "});",
                  "",
                  "pm.test(\"ISBN validation result is true\", function () {",
                  "    pm.expect(pm.response.text()).to.match(/<m:IsValidISBN13Result>true<\\/m:IsValidISBN13Result>/);",
                  "});",
                  "",
                  "pm.test(\"Content-Type header is text/xml; charset=utf-8\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\", \"text/xml; charset=utf-8\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
